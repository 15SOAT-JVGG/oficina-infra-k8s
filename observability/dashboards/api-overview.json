  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Infraestrutura",
      "type": "link",
      "url": "/observability/d/oficina-kubernetes",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Explorar logs e traces",
      "type": "link",
