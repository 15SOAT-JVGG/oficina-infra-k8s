      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 10,
      "title": "API: coleta disponível",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem coleta"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "min(up{job=\"oficina-mecanica-management\",namespace=\"$namespace\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Uptime público · 24h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem coleta",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "100 * avg(avg_over_time(probe_success{job=\"oficina-public-api-$namespace\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Requisições por segundo",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Aguardando métricas HTTP",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Aguardando métricas HTTP",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Respostas 5xx (%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Aguardando métricas HTTP",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Aguardando métricas HTTP",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval])) * 0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Latência p95 por rota",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Taxa de requisições por rota",
      "type": "timeseries"
    },
    {
      "id": 30,
      "title": "OS abertas hoje",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Aguardando coleta"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(workshop_work_orders_opened_today{namespace=\"$namespace\"})"
        }
      ],
      "description": "Abertas desde meia-noite no fuso do PostgreSQL. Agregado persistido; max evita contar uma vez por réplica."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 6,
        "y": 12,
        "w": 18,
        "h": 6
      },
      "id": 31,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(stage) (workshop_work_order_stage_duration_seconds{namespace=\"$namespace\"})",
          "legendFormat": "{{stage}}"
        }
      ],
      "title": "Tempo médio por etapa concluída",
      "type": "timeseries",
      "description": "Diagnóstico=DIAGNOSIS; Execução=IN_PROGRESS; Finalização=COMPLETED até DELIVERED. Histórico completo, somente etapas encerradas; OS canceladas excluídas. Réplicas usam max, não soma."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 6
      },
      "id": 32,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(integration) (increase(workshop_integration_calls_total{namespace=\"$namespace\",outcome=\"failure\"}[15m]))",
          "legendFormat": "{{integration}}"
        }
      ],
      "title": "Falhas das integrações · últimos 15 min",
      "type": "timeseries",
      "description": "SMTP e consulta dos indicadores no PostgreSQL. Falha SMTP não desfaz a OS; falhas de coleta não são reportadas como zero."
    },
    {
      "id": 33,
      "title": "Alertas de OS disparados",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Aguardando coleta"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertname=~\"WorkOrderProcessingFailure|WorkOrderNotificationFailure\",namespace=\"$namespace\",alertstate=\"firing\"}) or vector(0)"
        }
      ],
      "description": "Alertas Prometheus: processamento da OS e entrega SMTP. Zero indica nenhuma ocorrência disparada; pendências aparecem nas regras do Prometheus."
    },
    {
      "id": 14,
      "title": "Logs · abrir para investigar",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [
        {
          "id": 15,
          "title": "Logs da aplicação",
          "type": "logs",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 25
          },
          "targets": [
            {
              "expr": "{environment=\"$namespace\",service=\"oficina-mecanica\"} | json | line_format `{{.level}} · {{.message}}`",
              "refId": "A",
              "maxLines": 100
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": false,
            "wrapLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "prettifyLogMessage": false,
            "dedupStrategy": "none"
          },
          "description": "Clique na seta da seção para abrir. Cada evento mostra horário, nível e mensagem. Clique na linha para consultar os campos estruturados; Explore permite consultar o JSON original."
        }
      ]
    }
  ],
