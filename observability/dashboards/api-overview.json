      "targets": [
        {
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval])) * 0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"oficina-mecanica-management\",namespace=\"$namespace\"}[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
